# ── Runtime ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Neon: use the POOLED connection string for the app...
DATABASE_URL=postgresql://postgres@127.0.0.1:5433/tilt
# ...and the DIRECT (non-pooled) one for migrations (prisma.config.ts).
DIRECT_DATABASE_URL=
DB_POOL_MAX=5

# Comma-separated list of allowed browser origins (required in production).
CORS_ORIGINS=http://localhost:3000

# Admin routes need header x-admin-key. In production: 32+ random chars (openssl rand -hex 32).
ADMIN_API_KEY=dev-admin-key

# ── Publishing ─────────────────────────────────────────────
# local = write into LOCAL_PUBLISH_DIR (the web app serves it in dev)
# r2    = upload to Cloudflare R2 (production)
STORAGE_DRIVER=local
LOCAL_PUBLISH_DIR=../web/public/data
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tilt-data

# ── Scheduler ──────────────────────────────────────────────
# Six-field cron (seconds first). Default: every 5 minutes.
PUBLISH_CRON=0 */5 * * * *
SCHEDULER_ENABLED=true
